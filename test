    TweenService:Create(FlyStatus, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(80, 80, 80)}):Play()
    cleanupFly()
    
    if noclipEnabled then
        noclipEnabled = false
        TweenService:Create(NoclipStatus, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(80, 80, 80)}):Play()
    end
    
    if ragebaitEnabled then
        ragebaitEnabled = false
        TweenService:Create(RagebaitStatus, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(80, 80, 80)}):Play()
    end

    -- Re-apply Speed Lock if enabled
    if isSpeedLocked then applySpeedLock(char) end

    -- Re-apply Outfit / Headless Mods
    cacheDefaultAnimations(char)
    if cloneActive then
        applySavedOutfit(char)
    elseif headlessEnabled then
        applyHeadState(char)
    end
end)

if LocalPlayer.Character then
    cacheDefaultAnimations(LocalPlayer.Character)
end


