local function toggleFly()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local hum = char:FindFirstChildOfClass("Humanoid")
    flying = not flying

    if flying then
        TweenService:Create(FlyStatus, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(0, 255, 100)}):Play()
        if hum then hum.PlatformStand = true end

        local bg = Instance.new("BodyGyro")
        bg.P = 9e4; bg.maxTorque = Vector3.new(9e9, 9e9, 9e9); bg.cframe = hrp.CFrame; bg.Parent = hrp
        local bv = Instance.new("BodyVelocity")
        bv.velocity = Vector3.zero; bv.maxForce = Vector3.new(9e9, 9e9, 9e9); bv.Parent = hrp

        table.insert(flyParts, bg); table.insert(flyParts, bv)

        flyConnection = RunService.RenderStepped:Connect(function()
            local moveDir = Vector3.zero
            local cameraCFrame = Camera.CFrame
            if keys.W then moveDir += cameraCFrame.LookVector end
            if keys.S then moveDir -= cameraCFrame.LookVector end
            if keys.A then moveDir -= cameraCFrame.RightVector end
            if keys.D then moveDir += cameraCFrame.RightVector end
            if moveDir.Magnitude > 0 then moveDir = moveDir.Unit end

            bv.velocity = moveDir * FLY_SPEED
            bg.cframe = cameraCFrame
        end)
    else
        TweenService:Create(FlyStatus, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(80, 80, 80)}):Play()
        cleanupFly()
    end
end

