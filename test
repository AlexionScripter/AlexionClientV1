-- Draggable Submenus helper
local function makeDraggable(frame)
    local drag, dInput, dStart, sPos
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = true; dStart = input.Position; sPos = frame.Position
            input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then drag = false end end)
        end
    end)
    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then dInput = input end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dInput and drag then
            local delta = input.Position - dStart
            frame.Position = UDim2.new(sPos.X.Scale, sPos.X.Offset + delta.X, sPos.Y.Scale, sPos.Y.Offset + delta.Y)
        end
    end)
end
