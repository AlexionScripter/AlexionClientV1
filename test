    textLabel.BackgroundTransparency = 1; textLabel.TextColor3 = Color3.fromRGB(255, 255, 255); textLabel.TextStrokeTransparency = 0; textLabel.Font = Enum.Font.GothamBold
    textLabel.TextSize = 13

    local conn
    conn = RunService.RenderStepped:Connect(function()
        if not espEnabled or not targetPlayer.Parent then
            highlight:Destroy(); espGui:Destroy(); conn:Disconnect(); return
        end
        local targetChar = targetPlayer.Character
        local myChar = LocalPlayer.Character
        if targetChar and targetChar:FindFirstChild("HumanoidRootPart") and targetChar:FindFirstChild("Humanoid") and targetChar.Humanoid.Health > 0 then
            if highlight.Parent ~= targetChar then highlight.Parent = targetChar end
            if espGui.Parent ~= targetChar.HumanoidRootPart then espGui.Parent = targetChar.HumanoidRootPart end
            if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                local dist = math.floor((myChar.HumanoidRootPart.Position - targetChar.HumanoidRootPart.Position).Magnitude)
                textLabel.Text = targetPlayer.DisplayName .. "\n[" .. dist .. "m]"
            end
        else
            highlight.Parent = nil; espGui.Parent = nil
        end
    end)
    table.insert(espConnections, conn)
end

