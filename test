local function applySavedOutfit(char)
    if not readfile or not isfile or not isfile(FILE_NAME) then return end
    char:WaitForChild("Humanoid")
    task.wait(0.2) 

    local outfitData = HttpService:JSONDecode(readfile(FILE_NAME))

    task.spawn(function()
        local fetchedAccessories = {}
        if outfitData.Accessories then
            for _, id in ipairs(outfitData.Accessories) do
                local s, objs = pcall(function() return game:GetObjects("rbxassetid://" .. id) end)
                if s and objs and objs[1] then
                    table.insert(fetchedAccessories, objs[1])
                end
            end
        end

        for _, obj in pairs(char:GetChildren()) do
            if obj:IsA("Accessory") or obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("ShirtGraphic") then
                obj:Destroy()
            end
        end

        if outfitData.Colors then
            local bc = char:FindFirstChildOfClass("BodyColors") or Instance.new("BodyColors", char)
            bc.HeadColor3 = Color3.fromHex(outfitData.Colors.Head)
            bc.TorsoColor3 = Color3.fromHex(outfitData.Colors.Torso)
            bc.LeftArmColor3 = Color3.fromHex(outfitData.Colors.LArm)
            bc.RightArmColor3 = Color3.fromHex(outfitData.Colors.RArm)
            bc.LeftLegColor3 = Color3.fromHex(outfitData.Colors.LLeg)
            bc.RightLegColor3 = Color3.fromHex(outfitData.Colors.RLeg)
        end

        if outfitData.Shirt then Instance.new("Shirt", char).ShirtTemplate = outfitData.Shirt end
        if outfitData.Pants then Instance.new("Pants", char).PantsTemplate = outfitData.Pants end
        if outfitData.TShirt then Instance.new("ShirtGraphic", char).Graphic = outfitData.TShirt end
        
        if outfitData.Face then
            local head = char:FindFirstChild("Head")
            if head then
                local face = head:FindFirstChildOfClass("Decal") or Instance.new("Decal", head)
                face.Name = "face"
                face.Texture = outfitData.Face
            end
        end

        if outfitData.Animations then
            local animate = char:FindFirstChild("Animate")
            if animate then
                for animName, animId in pairs(outfitData.Animations) do
                    local animFolder = animate:FindFirstChild(animName)
                    if animFolder then
                        for _, animObj in pairs(animFolder:GetChildren()) do
                            if animObj:IsA("Animation") then
                                animObj.AnimationId = animId
                            end
                        end
                    end
                end
                
                local hum = char:FindFirstChildOfClass("Humanoid")
                local animator = hum and hum:FindFirstChildOfClass("Animator")
                if animator then
                    for _, track in pairs(animator:GetPlayingAnimationTracks()) do
                        track:Stop()
                    end
                end
                
                animate.Disabled = true
                task.wait(0.1)
                animate.Disabled = false
            end
        end

        for _, item in ipairs(fetchedAccessories) do
            if item:IsA("Accessory") then
                manuallyWeldAccessory(char, item)
            elseif item:IsA("Model") or item:IsA("Folder") then
                local acc = item:FindFirstChildOfClass("Accessory")
                if acc then manuallyWeldAccessory(char, acc) end
            end
        end
    end)
end

