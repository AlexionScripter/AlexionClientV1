local function themeSubMenu(frame)
    frame.BackgroundColor3 = Color3.fromRGB(28, 30, 48)
    frame.BorderSizePixel = 0
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)
    
    local title = frame:FindFirstChildOfClass("TextLabel")
    if title then title.TextColor3 = Color3.fromRGB(255, 255, 255) end
    
    local close = frame:FindFirstChild("TextButton")
    if close and close.Text == "X" then 
        close.BackgroundColor3 = Color3.fromRGB(45, 48, 70) 
    end
    
    for _, child in ipairs(frame:GetChildren()) do
        if child:IsA("TextBox") then
            child.BackgroundColor3 = Color3.fromRGB(20, 22, 35)
        end
    end
end

