-- [SHARED WELD FUNCTION FOR CLONERS]
local function manuallyWeldAccessory(character, accessory)
    pcall(function()
        local handle = accessory:FindFirstChild("Handle")
        if not handle then return end
        handle.CanCollide = false
        handle.Anchored = false
        local accAttachment = handle:FindFirstChildOfClass("Attachment")
        if not accAttachment then 
            accessory.Parent = character
            local head = character:FindFirstChild("Head")
            if head then
                local weld = Instance.new("Weld")
                weld.Name = "HatWeld"
                weld.Part0 = head
                weld.Part1 = handle
                weld.C0 = CFrame.new(0, 0.5, 0)
                weld.C1 = accessory.AttachmentPoint or CFrame.new()
                weld.Parent = handle
            end
            return 
        end
        local charAttachment, charPart = nil, nil
        for _, obj in ipairs(character:GetDescendants()) do
            if obj:IsA("Attachment") and obj.Name == accAttachment.Name and obj.Parent:IsA("BasePart") then
                charAttachment = obj
                charPart = obj.Parent
                break
            end
        end
        if charPart and charAttachment then
            accessory.Parent = character
            handle.CFrame = charPart.CFrame * charAttachment.CFrame * accAttachment.CFrame:Inverse()
            local weld = Instance.new("Weld")
            weld.Name = "AccessoryWeld"
            weld.Part0 = charPart
            weld.Part1 = handle
            weld.C0 = charAttachment.CFrame
            weld.C1 = accAttachment.CFrame
            weld.Parent = handle
        end
    end)
end

-- [USERNAME AVATAR CLONER LOGIC]
local function executeAvatarClone(username)
    ClonerStatus.Text = "Searching for " .. username
    ClonerStatus.TextColor3 = Color3.new(1, 1, 0)
    task.spawn(function()
        local success, userId = pcall(function() return Players:GetUserIdFromNameAsync(username) end)
        if not success or not userId then
            ClonerStatus.Text = "User not found!"
            ClonerStatus.TextColor3 = Color3.new(1, 0, 0)
            return
        end
        ClonerStatus.Text = "Applying avatar..."
        local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local humanoid = character:WaitForChild("Humanoid", 5)
        if not humanoid then return end
        
        local successApp, appearance = pcall(function() return Players:GetCharacterAppearanceAsync(userId) end)
        if not successApp or not appearance then
            ClonerStatus.Text = "Failed to load assets!"
            ClonerStatus.TextColor3 = Color3.new(1, 0, 0)
            return
        end
        
        pcall(function()
            local animate = character:FindFirstChild("Animate")
            if animate then
                local stolenAnims = {}
                for _, desc in ipairs(appearance:GetDescendants()) do
                    if desc:IsA("Animation") and desc.Parent then
                        stolenAnims[string.lower(desc.Parent.Name)] = desc.AnimationId
                    end
                end
                
                if stolenAnims["idle"] and animate:FindFirstChild("idle") then
                    if animate.idle:FindFirstChild("Animation1") then animate.idle.Animation1.AnimationId = stolenAnims["idle"] end
                    if animate.idle:FindFirstChild("Animation2") then animate.idle.Animation2.AnimationId = stolenAnims["idle"] end
                end
                if stolenAnims["walk"] and animate:FindFirstChild("walk") and animate.walk:FindFirstChild("WalkAnim") then animate.walk.WalkAnim.AnimationId = stolenAnims["walk"] end
                if stolenAnims["run"] and animate:FindFirstChild("run") and animate.run:FindFirstChild("RunAnim") then animate.run.RunAnim.AnimationId = stolenAnims["run"] end
                
                local animator = humanoid:FindFirstChildOfClass("Animator")
                if animator then for _, track in ipairs(animator:GetPlayingAnimationTracks()) do pcall(function() track:Stop() end) end end
                animate.Disabled = true
                task.wait(0.1); animate.Disabled = false
            end
        end)
        
        local displayName = username
        pcall(function()
            local userInfo = UserService:GetUserInfosByUserIdsAsync({userId})
            if userInfo and userInfo[1] then displayName = userInfo[1].DisplayName end
        end)
        
        pcall(function()
            for _, item in ipairs(character:GetChildren()) do
                if item:IsA("Accessory") or item:IsA("Hat") or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") then item:Destroy() end
            end
            for _, item in ipairs(appearance:GetChildren()) do
                if item:IsA("Accessory") or item:IsA("Hat") then
                    manuallyWeldAccessory(character, item:Clone())
                elseif item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") then
                    item:Clone().Parent = character
                elseif item:IsA("Decal") and item.Name == "Face" then
                    local head = character:FindFirstChild("Head")
                    if head then
                        local oldFace = head:FindFirstChildOfClass("Decal")
                        if oldFace then oldFace:Destroy() end
                        item:Clone().Parent = head
                    end
                end
            end
        end)
        
        CurrentTagName = displayName 
        ClonerStatus.Text = "Successfully cloned " .. displayName .. "!"
        ClonerStatus.TextColor3 = Color3.new(0, 1, 0)
    end)
end

