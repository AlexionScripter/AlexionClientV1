    local highlight = Instance.new("Highlight")
    highlight.Name = targetPlayer.Name .. "_Chams"
    highlight.FillColor = Color3.fromRGB(255, 50, 50); highlight.FillTransparency = 0.5; highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    local espGui = Instance.new("BillboardGui")
    espGui.Name = targetPlayer.Name .. "_Tag"
    espGui.AlwaysOnTop = true; espGui.Size = UDim2.new(0, 200, 0, 50); espGui.StudsOffset = Vector3.new(0, 3.5, 0)
    local textLabel = Instance.new("TextLabel", espGui)
