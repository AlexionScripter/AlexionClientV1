-- 3. SLIDER MATH & LOGIC
local minFov = 10  -- Max Zoom In
local maxFov = 120 -- Max Quake Pro Zoom Out
local fovDragging = false

local function updateFovSlider(input)
    -- Calculate where the mouse is on the slider (0.0 to 1.0)
    local pos = math.clamp((input.Position.X - fovTrack.AbsolutePosition.X) / fovTrack.AbsoluteSize.X, 0, 1)
    
    -- Move UI elements visually
    fovFill.Size = UDim2.new(pos, 0, 1, 0)
    fovKnob.Position = UDim2.new(pos, -10, 0.5, -10)
    
    -- Calculate and set actual FOV
    local currentFov = math.floor(minFov + ((maxFov - minFov) * pos))
    fovLabel.Text = "FOV: " .. tostring(currentFov)
    Camera.FieldOfView = currentFov
end

-- Mouse Click Logic
fovTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        fovDragging = true
        updateFovSlider(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        fovDragging = false
    end
end)

-- Mouse Drag Logic
UserInputService.InputChanged:Connect(function(input)
    if fovDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateFovSlider(input)
    end
end)

-- Set Initial Default State (70 FOV)
local initialFovPos = (70 - minFov) / (maxFov - minFov)
fovFill.Size = UDim2.new(initialFovPos, 0, 1, 0)
fovKnob.Position = UDim2.new(initialFovPos, -10, 0.5, -10)
Camera.FieldOfView = 70

-- Close Button Logic
fovCloseBtn.MouseButton1Click:Connect(function()
    FovGui:Destroy()
end)

