    VIM:SendMouseButtonEvent(screenCenter.X, screenCenter.Y, 0, true, game, 0)
    task.wait(0.01)
    VIM:SendMouseButtonEvent(screenCenter.X, screenCenter.Y, 0, false, game, 0)
