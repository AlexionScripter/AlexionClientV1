-- /// HELPER TO CREATE ALPINE MODULE CARDS ///
local function createModuleCard(name, iconText, hasStatusIndicator, layoutOrder)
    local Card = Instance.new("TextButton", ToolsPage)
    Card.Size = UDim2.new(1, 0, 1, 0)
    Card.BackgroundColor3 = Color3.fromRGB(28, 30, 48)
    Card.AutoButtonColor = false
    Card.Text = ""
    Card.LayoutOrder = layoutOrder
    Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 10)

    local Icon = Instance.new("TextLabel", Card)
    Icon.Size = UDim2.new(0, 40, 1, 0)
    Icon.Position = UDim2.new(0, 5, 0, 0)
    Icon.BackgroundTransparency = 1
    Icon.Text = iconText
    Icon.TextSize = 20

    local Title = Instance.new("TextLabel", Card)
    Title.Size = UDim2.new(1, -55, 1, 0)
    Title.Position = UDim2.new(0, 45, 0, 0)
    Title.BackgroundTransparency = 1
    Title.Text = name
    Title.TextColor3 = Color3.fromRGB(230, 230, 240)
    Title.Font = Enum.Font.GothamSemibold
    Title.TextSize = 13
    Title.TextXAlignment = Enum.TextXAlignment.Left

    local statusCircle = nil
    if hasStatusIndicator then
        statusCircle = Instance.new("Frame", Card)
        statusCircle.Size = UDim2.new(0, 8, 0, 8)
        statusCircle.Position = UDim2.new(1, -20, 0.5, -4)
        statusCircle.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
        Instance.new("UICorner", statusCircle).CornerRadius = UDim.new(1, 0)
    end

    -- Hover Effects
    Card.MouseEnter:Connect(function() Card.BackgroundColor3 = Color3.fromRGB(38, 40, 60) end)
    Card.MouseLeave:Connect(function() Card.BackgroundColor3 = Color3.fromRGB(28, 30, 48) end)

    return Card, statusCircle, Title
end

